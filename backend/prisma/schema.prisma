generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  mcq
  tf
  match
}

enum DifficultyLevel {
  Basic
  Intermediate
  Advanced
  Final
}

enum QuizMode {
  TOPIC_LEVEL
  SUBJECT_FINAL
  GLOBAL_FINAL
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  passwordHash  String
  avatarUrl     String?
  totalScore    Int            @default(0)
  quizzesTaken  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  attempts      QuizAttempt[]
  progress      UserProgress[]

  @@map("users")
}

model Subject {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String        @unique
  icon        String
  description String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  topics      Topic[]
  attempts    QuizAttempt[]
  progress    UserProgress[]

  @@map("subjects")
}

model Topic {
  id          String         @id @default(cuid())
  slug        String
  name        String
  description String?
  subjectId   String
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    QuizAttempt[]
  progress    UserProgress[]

  @@unique([subjectId, slug])
  @@unique([subjectId, name])
  @@map("topics")
}

model Question {
  id             String             @id @default(cuid())
  topicId        String
  externalId     String?
  type           QuestionType
  difficulty     DifficultyLevel
  prompt         String
  options        Json?
  answer         Json
  pairs          Json?
  explanation    String             @default("")
  imageUrl       String?
  timeLimitSec   Int?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  topic          Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  responses      QuestionResponse[]
  attemptItems   QuizAttemptQuestion[]

  @@index([topicId, difficulty])
  @@map("questions")
}

model QuizAttempt {
  id            String                @id @default(cuid())
  userId        String
  subjectId     String?
  topicId       String?
  level         DifficultyLevel
  mode          QuizMode              @default(TOPIC_LEVEL)
  score         Int                   @default(0)
  totalQs       Int
  percentage    Float                 @default(0)
  passed        Boolean               @default(false)
  durationSec   Int?
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic         Topic?                @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questions     QuizAttemptQuestion[]
  responses     QuestionResponse[]

  @@index([userId, startedAt])
  @@index([subjectId, level])
  @@index([topicId, level])
  @@map("quiz_attempts")
}

model QuizAttemptQuestion {
  id              String       @id @default(cuid())
  attemptId       String
  questionId      String
  orderIndex      Int
  promptSnapshot  String
  optionsSnapshot Json?
  pairsSnapshot   Json?
  createdAt       DateTime     @default(now())
  attempt         QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, orderIndex])
  @@unique([attemptId, questionId])
  @@map("quiz_attempt_questions")
}

model QuestionResponse {
  id            String       @id @default(cuid())
  attemptId     String
  questionId    String
  userAnswer    Json
  isCorrect     Boolean
  answeredAt    DateTime     @default(now())
  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("question_responses")
}

model UserProgress {
  id            String          @id @default(cuid())
  userId        String
  subjectId     String
  topicId       String
  level         DifficultyLevel
  completed     Boolean         @default(false)
  unlocked      Boolean         @default(false)
  bestScore     Float?
  attemptsCount Int             @default(0)
  lastAttemptAt DateTime?
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic         Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, level])
  @@index([userId, subjectId])
  @@map("user_progress")
}
